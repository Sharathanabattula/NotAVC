{
  "name": "notavc-video-pipeline",
  "version": "1.0.0",
  "description": "NotAVC video pipeline: whisper.cpp captions + Remotion vertical shorts",
  "scripts": {
    "setup:whisper": "bash scripts/setup-whisper.sh",
    "transcribe": "node scripts/transcribe.mjs",
    "short": "node scripts/make-short.mjs",
    "studio": "remotion studio src/index.ts",
    "reel:ranga-reddy": "remotion render src/index.ts RangaReddy output/ranga-reddy-reel.mp4 --codec=h264 --crf=18",
    "typecheck": "tsc -p .",
    "voiceover": "node scripts/voiceover-reel.mjs",
    "clone-voice": ".venv-tts/bin/python scripts/clone-voice.py",
    "setup:tts": "python3 -m venv .venv-tts && .venv-tts/bin/pip install --index-url https://download.pytorch.org/whl/cpu torch==2.6.0 torchaudio==2.6.0 && .venv-tts/bin/pip install chatterbox-tts"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@remotion/bundler": "4.0.539",
    "@remotion/captions": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
